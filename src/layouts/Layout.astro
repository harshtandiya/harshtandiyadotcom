---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Footer from "@/components/home/footer.astro";
import Sidebar from "@/components/home/sidebar.astro";
import Connect from "@/components/home/connect.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Harsh Tandiya</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Gloria+Hallelujah&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <script>
      import { bind, setEnabled, setVolume } from "cuelume";

      setEnabled(!matchMedia("(prefers-reduced-motion: reduce)").matches);
      setVolume(0.3);
      bind();

      // A link to the page you are already on still round-trips through the
      // router and replays the entry animation. Swallow it before ClientRouter's
      // own (bubble-phase, head-registered) handler sees the click.
      document.addEventListener(
        "click",
        (ev) => {
          if (ev.defaultPrevented || ev.button !== 0) return;
          if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;

          const target = ev.composed ? ev.composedPath()[0] : ev.target;
          const link = target instanceof Element ? target.closest("a[href]") : null;
          if (!(link instanceof HTMLAnchorElement)) return;
          if (link.hasAttribute("download")) return;
          if (link.target && link.target !== "_self") return;

          const url = new URL(link.href, location.href);
          if (url.origin !== location.origin || url.hash) return;
          if (url.pathname === location.pathname && url.search === location.search) {
            ev.preventDefault();
          }
        },
        { capture: true },
      );

      // Pages animate themselves in, but the outgoing page is swapped out
      // instantly. Blur it away first by holding the router's loader until the
      // exit animation finishes.
      document.addEventListener("astro:before-preparation", (ev) => {
        const main = document.querySelector("main");
        if (!main) return;

        const load = ev.loader;
        ev.loader = async () => {
          main.classList.add("animate-disappear");
          // Read the duration off the animation itself rather than repeating
          // the 300ms from `--animate-disappear`. No animation (reduced motion,
          // unsupported) means nothing to wait on.
          const exits = main
            .getAnimations()
            .map((animation) => animation.finished.catch(() => {}));
          await Promise.all([load(), ...exits]);
        };
      });

      // The swap replaces <main>, so the class normally leaves with it — this
      // only matters when a navigation is aborted partway.
      document.addEventListener("astro:page-load", () => {
        document.querySelector("main")?.classList.remove("animate-disappear");
      });
    </script>
    <div
      class="max-w-5xl w-full px-6 mr-auto min-h-screen flex flex-col md:flex-row md:gap-12"
    >
      <Sidebar />
      <div class="flex-1 min-w-0 flex flex-col md:py-12 min-h-0">
        <main class="flex-1 flex flex-col min-h-0 pt-8 md:pt-0">
          <slot />
        </main>
        <div class="md:hidden mt-12">
          <Connect />
        </div>
        <Footer />
      </div>
    </div>
  </body>
</html>
