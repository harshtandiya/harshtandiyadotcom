---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Footer from "@/components/home/footer.astro";

const { class: className } = Astro.props;
const wrapperClass = [
  "max-w-3xl w-full px-6 mx-auto min-h-screen flex flex-col",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Harsh Tandiya</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <script>
      import { bind, setEnabled, setVolume } from "cuelume";

      setEnabled(!matchMedia("(prefers-reduced-motion: reduce)").matches);
      setVolume(0.3);
      bind();
    </script>
    <div class={wrapperClass}>
      <main class="flex-1 flex flex-col min-h-0">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
