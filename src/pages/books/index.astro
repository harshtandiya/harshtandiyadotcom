---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import bookKitty from "@/assets/neko/bookKitty.svg";
---

<Layout>
  <div class="animate-appear flex flex-col gap-4 items-start [--appear-y:20px]">
    <Image
      src={bookKitty}
      alt="Book Kitty Illustration"
      class="w-auto h-[105px]"
    />
    <h1 class="text-xl font-hand">Books</h1>
    <p class="text-gray-400 italic font-base">Something will come here eventually.</p>
  </div>
</Layout>
