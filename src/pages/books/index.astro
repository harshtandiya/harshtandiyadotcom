---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import bookKitty from "@/assets/neko/bookKitty.svg";
import Shelf from "@/components/books/Shelf.astro";
---

<Layout>
  <div class="animate-appear flex flex-col gap-4 items-start">
    <Image
      src={bookKitty}
      alt="Book Kitty Illustration"
      class="w-auto h-[105px]"
    />
    <h1 class="text-xl font-hand">Books</h1>
    <div class="w-full mt-16">
      <Shelf />
    </div>
  </div>
</Layout>

<script>
  import { mountAll } from "@/components/books/shelf";
  mountAll();
</script>
