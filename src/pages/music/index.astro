---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import musicKitty from "@/assets/neko/musicKitty.svg";
---

<Layout>
  <div class="animate-appear flex flex-col gap-4 items-start [--appear-y:20px]">
    <Image
      src={musicKitty}
      alt="Music Kitty Illustration"
      class="w-auto h-[63px]"
    />
    <h1 class="text-xl font-hand">Music</h1>
    <p class="text-gray-400 italic font-base">Something will come here eventually.</p>
  </div>
</Layout>
