---
import Layout from "@/layouts/Layout.astro";
import Turntable from "@/components/music/Turntable.astro";
import SongList from "@/components/music/SongList.astro";
---

<Layout wide>
  <div class="animate-appear flex flex-col gap-4 items-start">
    <h1 class="sr-only">Music</h1>
    <div data-player class="w-full grid gap-10 lg:grid-cols-2 lg:items-start">
      <div class="lg:sticky lg:top-12">
        <Turntable />
      </div>
      <div class="lg:order-first">
        <SongList />
      </div>
    </div>
  </div>
</Layout>

<script>
  import { mountAll } from "@/components/music/player";
  mountAll();
</script>
