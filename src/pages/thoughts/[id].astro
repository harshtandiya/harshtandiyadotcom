---
import Layout from "@/layouts/Layout.astro";
import { Undo2 } from "@lucide/astro";

export function getStaticPaths() {
  return [];
}

const { id } = Astro.params;
---

<Layout>
  <div class="flex flex-col gap-4 mt-12 relative">
    <a
      href="/thoughts"
      class="no-style md:absolute top-4 md:-left-18 text-gray-500 flex items-center gap-1 hover:text-gray-900 transition-colors duration-150 -m-2 p-2"
    >
      <Undo2 class="w-4 h-4" />
      <span class="text-sm">back</span>
    </a>
    <h1 class="text-lg font-semibold">Thought</h1>
    <p class="text-gray-600">No thought with id “{id}” yet.</p>
  </div>
</Layout>
