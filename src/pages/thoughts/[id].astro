---
import Layout from "@/layouts/Layout.astro";
import LinkWithSound from "@/components/react/LinkWithSound";
import { Undo2 } from "@lucide/astro";

export function getStaticPaths() {
  return [];
}

const { id } = Astro.params;
---

<Layout>
  <div class="flex flex-col gap-4 mt-12 relative">
    <LinkWithSound client:load href="/thoughts" target="_self" className="no-style">
      <div
        class="md:absolute top-4 md:-left-18 text-gray-500 flex items-center gap-1 no-style hover:text-gray-900 cursor-pointer transition-colors duration-150 -m-2 p-2"
      >
        <Undo2 class="w-4 h-4" />
        <span class="text-sm">back</span>
      </div>
    </LinkWithSound>
    <h1 class="text-lg font-semibold">Thought</h1>
    <p class="text-gray-600">No thought with id “{id}” yet.</p>
  </div>
</Layout>
