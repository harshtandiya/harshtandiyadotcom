---
import LinkWithSound from "@/components/react/LinkWithSound";
import Layout from "@/layouts/Layout.astro";
import { Undo2 } from "@lucide/astro";
import { Image } from "astro:assets";
import nerdKitty from "@/assets/neko/nerdKitty.svg";
---

<Layout>
  <div class="flex flex-col gap-4 mt-12 relative">
    <LinkWithSound client:load href="/" target="_self" className="no-style">
      <div
        class="md:absolute top-4 md:-left-18 text-gray-500 flex items-center gap-1 no-style hover:text-gray-900 cursor-pointer transition-colors duration-150"
      >
        <Undo2 class="w-4 h-4" />
        <span class="text-sm">back</span>
      </div>
    </LinkWithSound>
    <div class="flex flex-col gap-4 items-start">
      <Image
        src={nerdKitty}
        alt="Nerd Kitty Illustration"
        class="w-auto h-12"
      />
      <h1 class="text-xl font-semibold">Thoughts</h1>
      <p class="text-gray-400 italic font-base">Something will come here eventually.</p>
    </div>
  </div>
</Layout>
