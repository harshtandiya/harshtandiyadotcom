---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import ogNeko from "../assets/neko/OgNeko.svg";
---

<Layout>
  <div class="flex flex-col justify-between h-svh">
    <div class="mt-12 flex flex-col gap-10">
      <div class="flex flex-col gap-6 items-start">
        <a href="/" class="no-style">
          <Image
            src={ogNeko}
            alt="Image of a cat that I use as my mascot"
            class="w-auto h-12"
          />
        </a>
        <div class="flex flex-col gap-1">
          <h1 class="font-semibold">Harsh Tandiya</h1>
          <h2>Software Engineer</h2>
        </div>
        <p>
          Crafting polished software and experiences at
          <a
            href="https://studios.buildwithhussain.com"
            target="_blank"
            rel="noopener noreferrer">BWH Studios</a
          >
          <br />
          <br />
          I believe great software shows care in the details and I strive to bring
          that level of craftsmanship to every project.
          <br />
          <br />
          I'm currently based in <span class="italic">Bengaluru, India</span>.
        </p>
      </div>
    </div>
    <footer class="mt-12 flex justify-between gap-4">
      <div>
        <a
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/?ref=chooser-v1"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-400 text-xs"
        >
          CC BY-NC-SA 4.0
        </a>
      </div>
    </footer>
  </div>
</Layout>
