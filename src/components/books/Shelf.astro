---
import { Image } from "astro:assets";
import SHELF from "./shelf.json";

// shelf.json is a list of batches, one per row. Every item has a `pose`:
//   0 book, spine-on        2 book, cover facing out
//   1 book, leaning right   3 book, leaning left        4 prop (PNG)
// e.g. poses [4, 0, 1, 2, 4]: prop, spine, a book leaning onto a face-out
// cover, prop. Sizes are real cm; widths follow each image's own aspect. A
// prop's `drop` is how far its image runs below the shelf line (baked shadow).
const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/{books,decor}/*.{jpg,png,webp}", {
  eager: true,
});
const load = (path: string) => {
  const image = images[`/src/assets/${path}`]?.default;
  if (!image) throw new Error(`Shelf: no image at src/assets/${path}`);
  return image;
};
const widthOf = (image: ImageMetadata, height: number) => (height * image.width) / image.height;

const PROP = 4;

const rows = SHELF.map((batch) =>
  batch.map((item) => {
    if (item.pose === PROP) {
      if (!("decor" in item)) throw new Error(`Shelf: pose 4 needs a "decor" image`);
      const src = load(`decor/${item.decor}`);
      const drop = item.drop ?? 0;
      return { ...item, kind: "prop" as const, src, drop, width: widthOf(src, item.height + drop) };
    }
    if (!("cover" in item)) throw new Error(`Shelf: pose ${item.pose} needs a book`);
    const cover = load(`books/${item.cover}`);
    return { ...item, kind: "book" as const, cover, width: widthOf(cover, item.height) };
  }),
);

// Scale (px per cm) so the widest row fits its container on any screen, capped
// at 0.8rem. Each row needs fitCm·cm + fixedRem: spines count both their cm
// depth and their 1.5rem minimum, so the estimate errs on the roomy side.
const TIP = (12 * Math.PI) / 180; // matches --tip
const footprint = (item: (typeof rows)[number][number]) => {
  if (item.kind === "prop") return item.width;
  if (item.pose === 2) return item.width;
  if (item.pose === 0) return item.depth;
  return item.depth * Math.cos(TIP) + item.height * Math.sin(TIP);
};
const fits = rows.map((row) => {
  const fitCm = row.reduce((sum, item) => sum + footprint(item), 0);
  const spines = row.filter((item) => item.kind === "book" && item.pose !== 2).length;
  const props = row.length - row.filter((item) => item.kind === "book").length;
  const fixedRem = 3 + spines * 1.5 + props * 2.5; // row padding, spine minimums, prop margins
  return `(100cqi - ${fixedRem}rem) / ${fitCm.toFixed(2)}`;
});
const cm = `clamp(0.3rem, min(${fits.join(", ")}), 0.8rem)`;
---

<div class="bookshelf">
<div data-shelf class="shelf" style={`--cm: ${cm}`}>
  {
    rows.map((row) => (
      <div class="shelf-level">
        <ul class="shelf-row">
          {row.map((item) => {
            if (item.kind === "prop")
              return (
                <li class="decor" aria-hidden="true" style={`--w: ${item.width}; --h: ${item.height}; --drop: ${item.drop}`}>
                  <Image src={item.src} alt="" width={600} />
                </li>
              );
            const book = item;
            return (
              <li class={`book-slot pose-${book.pose}`} style={`--w: ${book.width}; --h: ${book.height}; --d: ${book.depth}`}>
                <button
                  type="button"
                  data-book
                  data-cuelume-press
                  aria-expanded="false"
                  aria-label={`${book.title} by ${book.author}`}
                  class="book-hit"
                >
                  <span class="book">
                    <Image class="book-face book-cover" src={book.cover} alt="" width={400} />
                    <span
                      class:list={["book-face book-spine", book.spineStyle && `spine-${book.spineStyle}`]}
                      style={`--spine: ${book.spine}; --ink: ${book.ink}`}
                    >
                      <span class="book-spine-title">{book.spineTitle ?? book.title}</span>
                      <span class="book-spine-author">{book.author}</span>
                    </span>
                    <span class="book-face book-pages" />
                    <span class="book-face book-top" />
                    <span class="book-face book-back" style={`--spine: ${book.spine}`} />
                  </span>
                </button>
              </li>
            );
          })}
        </ul>
        <div class="shelf-plank"></div>
      </div>
    ))
  }
</div>
</div>

<style is:global>
  /* Registered so --cm resolves once on .shelf (cqi against .bookshelf) and
     descendants inherit plain px. Unregistered, cqi would re-resolve at each
     use, and inside vertical spines "inline" means height. */
  @property --cm {
    syntax: "<length>";
    inherits: true;
    initial-value: 12.8px; /* must be absolute; 0.8rem at 16px */
  }

  .bookshelf {
    container-type: inline-size;
  }

  .shelf {
    --lean: 90deg; /* spine square to the viewer, as books stand on a shelf */
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .shelf-level {
    position: relative;
  }

  /* An opened book flies forward; keep it above the rows painted after it. */
  .shelf-level:has([aria-expanded="true"]) {
    z-index: 1;
  }

  .shelf-row {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    gap: 0;
    padding-inline: 1.5rem;
  }

  /* Cut-out images standing on the plank, scaled to their real height. They
     carry their own shadow; `--drop` lets it run onto the plank's top. */
  .decor {
    flex-shrink: 0;
    width: calc(var(--w) * var(--cm));
    height: calc((var(--h) + var(--drop)) * var(--cm));
    margin-bottom: calc(var(--drop) * var(--cm) * -1);
    margin-inline: 1.25rem;
  }

  .decor img {
    width: 100%;
    height: 100%;
  }

  .book-slot {
    --W: calc(var(--w) * var(--cm));
    --H: calc(var(--h) * var(--cm));
    /* Thin paperbacks get a floor so the spine stays readable and clickable. */
    --D: max(var(--d) * var(--cm), 1.5rem);
    /* Footprint of the turned book: cover foreshortened plus the spine. */
    --fw: calc(var(--W) * cos(var(--lean)) + var(--D) * sin(var(--lean)));
    /* How far a leaning book tips (always positive; the pose sets the side). */
    --tip: 0deg;
    position: relative;
    flex-shrink: 0;
    width: calc(var(--fw) * cos(var(--tip)) + var(--H) * sin(var(--tip)));
    height: calc(var(--H) * cos(var(--tip)) + var(--fw) * sin(var(--tip)));
  }

  /* Batch poses. Leaners pivot on the corner that stays on the plank. */
  .pose-1,
  .pose-3 {
    --tip: 12deg;
  }

  .pose-2 {
    --lean: 0deg;
  }

  .pose-1 .book-hit {
    left: calc(var(--fw) * cos(var(--tip)) - var(--fw));
    transform-origin: bottom right;
    rotate: var(--tip);
  }

  .pose-3 .book-hit {
    left: calc(var(--H) * sin(var(--tip)));
    transform-origin: bottom left;
    rotate: calc(var(--tip) * -1);
  }

  /* An opened book straightens up as it comes out. */
  .book-slot .book-hit[aria-expanded="true"] {
    rotate: 0deg;
  }

  /* Flat, spine-sized click target. The 3D book inside is edge-on at rest and
     would leave almost nothing to hit. Each book also gets its own eye, so at
     rest every spine is seen head-on. */
  .book-hit {
    position: absolute;
    bottom: 0;
    left: 0;
    width: var(--fw);
    height: var(--H);
    display: block;
    cursor: pointer;
    transition: rotate 650ms var(--ease-out-strong);
    perspective: 1400px;
    perspective-origin: 50% 30%;
  }

  /* Each slot paints flat in DOM order; lift the active book over its neighbours. */
  .book-slot:has(.book-hit:hover, .book-hit:focus-visible) {
    z-index: 1;
  }

  .book-slot:has([aria-expanded="true"]) {
    z-index: 2;
  }

  .book {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: var(--W);
    height: var(--H);
    margin-left: calc(var(--W) / -2);
    transform-style: preserve-3d;
    /* Pull the spine back onto the shelf line so every book's spine sits at z=0. */
    translate: 0 0 calc(var(--W) / -2 * sin(var(--lean)));
    rotate: y var(--lean);
    transition:
      translate 650ms var(--ease-out-strong),
      rotate 650ms var(--ease-out-strong);
  }

  .book-hit:hover .book,
  .book-hit:focus-visible .book {
    translate: 0 -0.4rem calc(var(--W) / -2 * sin(var(--lean)) + 1rem);
  }

  [aria-expanded="true"] .book {
    translate: 0 -2rem 9rem;
    rotate: y -14deg;
  }

  .book-hit:focus-visible {
    outline: none;
  }

  .book-hit:focus-visible .book-spine {
    outline: 2px solid black;
    outline-offset: 2px;
  }

  .book-face {
    position: absolute;
    display: block;
    backface-visibility: hidden;
  }

  .book-cover {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0 2px 2px 0;
    translate: 0 0 calc(var(--D) / 2);
  }

  /* Hinge crease and a soft sheen across the cover. */
  .book::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 0 2px 2px 0;
    background:
      linear-gradient(90deg, #0000 2.5%, #00000038 3.5%, #ffffff30 5%, #0000 8%),
      linear-gradient(115deg, #ffffff1f 0%, #0000 40%, #0000 70%, #00000014 100%);
    translate: 0 0 calc(var(--D) / 2 + 0.5px);
    backface-visibility: hidden;
    pointer-events: none;
  }

  .book-back {
    inset: 0;
    background: var(--spine);
    rotate: y 180deg;
    translate: 0 0 calc(var(--D) / -2);
  }

  .book-spine {
    top: 0;
    left: calc(var(--W) / 2 - var(--D) / 2);
    width: var(--D);
    height: 100%;
    rotate: y -90deg;
    translate: calc(var(--W) / -2) 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: max(0.25rem, 0.6 * var(--cm));
    /* Vertical text: inline padding is the spine's top and bottom. */
    padding-inline: max(0.4rem, 1.75 * var(--cm));
    overflow: hidden;
    writing-mode: vertical-rl;
    color: var(--ink);
    /* Default spine face: Timeless Grotesk. Styles below swap it per cover. */
    font-family: var(--font-grotesk);
    /* Rounded spine: darker at both hinges, a highlight just off-center. */
    background:
      linear-gradient(90deg, #00000059, #0000 22%, #ffffff26 45%, #0000 70%, #00000066),
      var(--spine);
  }

  /* Short spines keep the title; the author gives way first. */
  .book-spine-title {
    flex: 0 0 auto;
    max-inline-size: 100%;
    font-size: clamp(0.45rem, min(var(--D) * 0.42, 1.1 * var(--cm)), 0.8rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .book-spine-author {
    flex: 0 1 auto;
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: clamp(0.4rem, min(var(--D) * 0.32, 0.85 * var(--cm)), 0.65rem);
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: 0.8;
  }

  /* `spineStyle` in shelf.json picks one of these, matched to the lettering
     on the cover. All Timeless; `STYL` 100 is Sans (vs Grotesk) or Serif Text. */
  .spine-vintage .book-spine-title {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .spine-vintage .book-spine-author {
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 1;
  }

  /* Penguin Select Classics: yellow spine, serif title, script author (Serif
     italic is the nearest Timeless has to the script). */
  .spine-penguin-select .book-spine-title {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .spine-penguin-select .book-spine-author {
    font-family: var(--font-serif);
    font-style: italic;
    letter-spacing: 0;
    opacity: 1;
  }

  .spine-death-note .book-spine-title {
    font-family: var(--font-serif);
    font-size: clamp(0.5rem, min(var(--D) * 0.55, 1.4 * var(--cm)), 1.05rem);
    letter-spacing: 0.04em;
  }

  /* Paper: fine stripes for page edges, warmer toward the middle of the block. */
  .book-pages {
    top: 2px;
    left: calc(var(--W) / 2 - var(--D) / 2);
    width: var(--D);
    height: calc(100% - 4px);
    rotate: y 90deg;
    translate: calc(var(--W) / 2 - 2px) 0 0;
    background:
      linear-gradient(90deg, #0000004d, #0000 25%, #0000 75%, #00000040),
      repeating-linear-gradient(90deg, #f6f1e4 0 1px, #ddd4bf 1px 2px);
  }

  .book-top {
    top: calc(var(--H) / 2 - var(--D) / 2);
    left: 0;
    width: calc(100% - 2px);
    height: var(--D);
    rotate: x 90deg;
    translate: 0 calc(var(--H) / -2 + 1px) 0;
    background: repeating-linear-gradient(0deg, #f6f1e4 0 1px, #ddd4bf 1px 2px);
  }

  /* The plank seen from a little above: its top surface, which the books
     stand on, then the front edge. Tapered sides fake the perspective. */
  .shelf-plank {
    --top: 1.25rem;
    --edge: 1.1rem;
    height: calc(var(--top) + var(--edge));
    /* Tuck under the row so things stand partway onto the top, not on its back edge. */
    margin-top: calc(var(--top) * -0.6);
    filter: drop-shadow(0 10px 10px #0000003d);
  }

  .shelf-plank::before {
    content: "";
    display: block;
    height: 100%;
    clip-path: polygon(0.75rem 0, calc(100% - 0.75rem) 0, 100% var(--top), 100% 100%, 0 100%, 0 var(--top));
    background:
      linear-gradient(#0000004d, #0000 40%) 0 0 / 100% var(--top) no-repeat,
      linear-gradient(#0000 calc(var(--top) - 1px), #ffffff59 calc(var(--top) - 1px) calc(var(--top) + 1px), #0000 0),
      linear-gradient(#0000 var(--top), #ffffff26 var(--top), #0000 calc(var(--top) + 0.35rem)),
      repeating-linear-gradient(90deg, #0000 0 37px, #00000010 37px 39px, #0000 39px 83px),
      linear-gradient(#a8784f, #c39468 var(--top), #b0815a var(--top), #8a5f3c);
  }

  @media (prefers-reduced-motion: reduce) {
    .book,
    .book-hit {
      transition: none;
    }
  }
</style>
