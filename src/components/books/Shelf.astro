---
import { Image } from "astro:assets";
import ROWS from "./shelf.json";

// Each row lists, left to right: books, props ({ decor, height }) and flexible
// gaps ({ space }). Sizes are real cm; widths follow each image's own aspect.
const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/{books,decor}/*.{jpg,png,webp}", {
  eager: true,
});
const load = (path: string) => {
  const image = images[`/src/assets/${path}`]?.default;
  if (!image) throw new Error(`Shelf: no image at src/assets/${path}`);
  return image;
};
const widthOf = (image: ImageMetadata, height: number) => (height * image.width) / image.height;

const rows = ROWS.map((row) =>
  row.map((item) => {
    if ("cover" in item) {
      const cover = load(`books/${item.cover}`);
      return { ...item, kind: "book" as const, cover, width: widthOf(cover, item.height) };
    }
    if ("decor" in item) {
      const src = load(`decor/${item.decor}`);
      return { ...item, kind: "decor" as const, src, width: widthOf(src, item.height) };
    }
    return { ...item, kind: "space" as const };
  }),
);
---

<div data-shelf class="shelf">
  {
    rows.map((row) => (
      <div class="shelf-level">
        <ul class="shelf-row">
          {row.map((item) => {
            if (item.kind === "space") return <li class="shelf-space" aria-hidden="true" style={`--grow: ${item.space}`} />;
            if (item.kind === "decor")
              return (
                <li class="decor" aria-hidden="true" style={`--w: ${item.width}; --h: ${item.height}`}>
                  <Image src={item.src} alt="" width={600} />
                </li>
              );
            const book = item;
            return (
              <li class="book-slot" style={`--w: ${book.width}; --h: ${book.height}; --d: ${book.depth}`}>
                <button
                  type="button"
                  data-book
                  data-cuelume-press
                  aria-expanded="false"
                  aria-label={`${book.title} by ${book.author}`}
                  class="book-hit"
                >
                  <span class="book">
                    <Image class="book-face book-cover" src={book.cover} alt="" width={400} />
                    <span
                      class:list={["book-face book-spine", book.spineStyle && `spine-${book.spineStyle}`]}
                      style={`--spine: ${book.spine}; --ink: ${book.ink}`}
                    >
                      <span class="book-spine-title">{book.spineTitle ?? book.title}</span>
                      <span class="book-spine-author">{book.author}</span>
                    </span>
                    <span class="book-face book-pages" />
                    <span class="book-face book-top" />
                    <span class="book-face book-back" style={`--spine: ${book.spine}`} />
                  </span>
                </button>
              </li>
            );
          })}
        </ul>
        <div class="shelf-plank"></div>
      </div>
    ))
  }
</div>

<style is:global>
  .shelf {
    --cm: 0.8rem;
    --lean: 90deg; /* spine square to the viewer, as books stand on a shelf */
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .shelf-level {
    position: relative;
  }

  /* An opened book flies forward; keep it above the rows painted after it. */
  .shelf-level:has([aria-expanded="true"]) {
    z-index: 1;
  }

  .shelf-row {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    gap: 0;
    padding-inline: 1.5rem;
  }

  .shelf-space {
    flex-grow: var(--grow);
  }

  /* Cut-out photos standing on the plank, scaled to their real height. */
  .decor {
    flex-shrink: 0;
    width: calc(var(--w) * var(--cm));
    height: calc(var(--h) * var(--cm));
    margin-inline: 0.5rem;
  }

  .decor img {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 4px 4px #00000040);
  }

  .book-slot {
    --W: calc(var(--w) * var(--cm));
    --H: calc(var(--h) * var(--cm));
    /* Thin paperbacks get a floor so the spine stays readable and clickable. */
    --D: max(var(--d) * var(--cm), 1.5rem);
    position: relative;
    flex-shrink: 0;
    /* Footprint of the turned book: cover foreshortened plus the spine. */
    width: calc(var(--W) * cos(var(--lean)) + var(--D) * sin(var(--lean)));
    height: var(--H);
  }

  /* Flat, spine-sized click target. The 3D book inside is edge-on at rest and
     would leave almost nothing to hit. Each book also gets its own eye, so at
     rest every spine is seen head-on. */
  .book-hit {
    position: absolute;
    inset: 0;
    display: block;
    cursor: pointer;
    perspective: 1400px;
    perspective-origin: 50% 30%;
  }

  /* Each slot paints flat in DOM order; lift the active book over its neighbours. */
  .book-slot:has(.book-hit:hover, .book-hit:focus-visible) {
    z-index: 1;
  }

  .book-slot:has([aria-expanded="true"]) {
    z-index: 2;
  }

  .book {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: var(--W);
    height: var(--H);
    margin-left: calc(var(--W) / -2);
    transform-style: preserve-3d;
    /* Pull the spine back onto the shelf line so every book's spine sits at z=0. */
    translate: 0 0 calc(var(--W) / -2 * sin(var(--lean)));
    rotate: y var(--lean);
    transition:
      translate 650ms var(--ease-out-strong),
      rotate 650ms var(--ease-out-strong);
  }

  .book-hit:hover .book,
  .book-hit:focus-visible .book {
    translate: 0 -0.4rem calc(var(--W) / -2 * sin(var(--lean)) + 1rem);
  }

  [aria-expanded="true"] .book {
    translate: 0 -2rem 9rem;
    rotate: y -14deg;
  }

  .book-hit:focus-visible {
    outline: none;
  }

  .book-hit:focus-visible .book-spine {
    outline: 2px solid black;
    outline-offset: 2px;
  }

  .book-face {
    position: absolute;
    display: block;
    backface-visibility: hidden;
  }

  .book-cover {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0 2px 2px 0;
    translate: 0 0 calc(var(--D) / 2);
  }

  /* Hinge crease and a soft sheen across the cover. */
  .book::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 0 2px 2px 0;
    background:
      linear-gradient(90deg, #0000 2.5%, #00000038 3.5%, #ffffff30 5%, #0000 8%),
      linear-gradient(115deg, #ffffff1f 0%, #0000 40%, #0000 70%, #00000014 100%);
    translate: 0 0 calc(var(--D) / 2 + 0.5px);
    backface-visibility: hidden;
    pointer-events: none;
  }

  .book-back {
    inset: 0;
    background: var(--spine);
    rotate: y 180deg;
    translate: 0 0 calc(var(--D) / -2);
  }

  .book-spine {
    top: 0;
    left: calc(var(--W) / 2 - var(--D) / 2);
    width: var(--D);
    height: 100%;
    rotate: y -90deg;
    translate: calc(var(--W) / -2) 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    /* Vertical text: inline padding is the spine's top and bottom. */
    padding-inline: 1.4rem;
    overflow: hidden;
    writing-mode: vertical-rl;
    color: var(--ink);
    /* Default spine face: Timeless Grotesk. Styles below swap it per cover. */
    font-family: var(--font-grotesk);
    /* Rounded spine: darker at both hinges, a highlight just off-center. */
    background:
      linear-gradient(90deg, #00000059, #0000 22%, #ffffff26 45%, #0000 70%, #00000066),
      var(--spine);
  }

  .book-spine-title {
    font-size: clamp(0.5rem, calc(var(--D) * 0.42), 0.8rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .book-spine-author {
    font-size: clamp(0.45rem, calc(var(--D) * 0.32), 0.65rem);
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: 0.8;
  }

  /* `spineStyle` in shelf.json picks one of these, matched to the lettering
     on the cover. All Timeless; `STYL` 100 is Sans (vs Grotesk) or Serif Text. */
  .spine-vintage .book-spine-title {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .spine-vintage .book-spine-author {
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 1;
  }

  /* Penguin Select Classics: yellow spine, serif title, script author (Serif
     italic is the nearest Timeless has to the script). */
  .spine-penguin-select .book-spine-title {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .spine-penguin-select .book-spine-author {
    font-family: var(--font-serif);
    font-style: italic;
    letter-spacing: 0;
    opacity: 1;
  }

  .spine-death-note .book-spine-title {
    font-family: var(--font-serif);
    font-size: clamp(0.6rem, calc(var(--D) * 0.55), 1.05rem);
    letter-spacing: 0.04em;
  }

  /* Paper: fine stripes for page edges, warmer toward the middle of the block. */
  .book-pages {
    top: 2px;
    left: calc(var(--W) / 2 - var(--D) / 2);
    width: var(--D);
    height: calc(100% - 4px);
    rotate: y 90deg;
    translate: calc(var(--W) / 2 - 2px) 0 0;
    background:
      linear-gradient(90deg, #0000004d, #0000 25%, #0000 75%, #00000040),
      repeating-linear-gradient(90deg, #f6f1e4 0 1px, #ddd4bf 1px 2px);
  }

  .book-top {
    top: calc(var(--H) / 2 - var(--D) / 2);
    left: 0;
    width: calc(100% - 2px);
    height: var(--D);
    rotate: x 90deg;
    translate: 0 calc(var(--H) / -2 + 1px) 0;
    background: repeating-linear-gradient(0deg, #f6f1e4 0 1px, #ddd4bf 1px 2px);
  }

  /* The plank seen from a little above: its top surface, which the books
     stand on, then the front edge. Tapered sides fake the perspective. */
  .shelf-plank {
    --top: 1.25rem;
    --edge: 1.1rem;
    height: calc(var(--top) + var(--edge));
    /* Tuck under the row so things stand partway onto the top, not on its back edge. */
    margin-top: calc(var(--top) * -0.6);
    filter: drop-shadow(0 10px 10px #0000003d);
  }

  .shelf-plank::before {
    content: "";
    display: block;
    height: 100%;
    clip-path: polygon(0.75rem 0, calc(100% - 0.75rem) 0, 100% var(--top), 100% 100%, 0 100%, 0 var(--top));
    background:
      linear-gradient(#0000004d, #0000 40%) 0 0 / 100% var(--top) no-repeat,
      linear-gradient(#0000 calc(var(--top) - 1px), #ffffff59 calc(var(--top) - 1px) calc(var(--top) + 1px), #0000 0),
      linear-gradient(#0000 var(--top), #ffffff26 var(--top), #0000 calc(var(--top) + 0.35rem)),
      repeating-linear-gradient(90deg, #0000 0 37px, #00000010 37px 39px, #0000 39px 83px),
      linear-gradient(#a8784f, #c39468 var(--top), #b0815a var(--top), #8a5f3c);
  }

  @media (prefers-reduced-motion: reduce) {
    .book {
      transition: none;
    }
  }
</style>
