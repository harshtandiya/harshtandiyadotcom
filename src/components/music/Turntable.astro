<div class="tt">
  <img class="tt-deck" src="/turntable/deck.webp" alt="" width="1180" height="702" />

  <div class="tt-disc">
    <img src="/turntable/record.webp" alt="" width="730" height="519" />
    <div class="tt-squash">
      <div class="tt-spin">
        <svg class="tt-label" viewBox="0 0 100 100" aria-hidden="true">
          <defs>
            <path id="tt-arc" d="M 50 23 a 27 27 0 1 1 -0.01 0" fill="none"></path>
          </defs>
          <text class="tt-title"><textPath href="#tt-arc" data-title></textPath></text>
          <text class="tt-artist" x="50" y="70" text-anchor="middle" data-artist></text>
          <text class="tt-side" x="50" y="61" text-anchor="middle">33⅓ · SIDE A</text>
        </svg>
      </div>
    </div>
  </div>

  <div class="tt-spindle"></div>

  <img class="tt-knob" src="/turntable/knob.webp" alt="" width="119" height="157" />

  <div class="tt-slot"></div>
  <button type="button" class="tt-power" data-power aria-label="Turntable power" aria-pressed="false" data-cuelume-press>
    <img src="/turntable/slider.webp" alt="" width="70" height="93" />
  </button>

  <img class="tt-arm" src="/turntable/arm.webp" alt="" width="205" height="716" />
</div>

<style is:global>
  .tt {
    position: relative;
    container-type: inline-size;
  }

  .tt img {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }

  .tt-disc {
    position: absolute;
    left: 15.17%;
    top: 5.41%;
    width: 61.86%;
    opacity: 0;
    filter: drop-shadow(0 0.3cqw 0.4cqw #0000004d);
  }

  /* Squashed to the deck's tilt (platter aspect 0.711) so the label turns in
     the deck's plane. Oversized to hide the record photo's own label. */
  .tt-squash {
    position: absolute;
    left: 49.86%;
    top: 47.01%;
    width: 46.6%;
    aspect-ratio: 1;
    translate: -50% -50%;
    scale: 1 0.711;
  }

  .tt-spin {
    position: absolute;
    inset: 0;
    animation: tt-spin 1.8s linear infinite paused; /* 33⅓ rpm */
  }

  [data-phase="playing"] .tt-spin {
    animation-play-state: running;
  }

  .tt-label {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(
      circle closest-side,
      #efe7d5 0 71%,
      #00000026 71.6%,
      var(--label, #d4572f) 72.5% 98.5%,
      #0000 99.5%
    );
    font-family: var(--font-sans);
  }

  .tt-title {
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.3px;
    fill: #3a332c;
  }

  .tt-artist {
    font-size: 6.5px;
    fill: #3a332cb3;
  }

  .tt-side {
    font-size: 3.6px;
    letter-spacing: 0.6px;
    fill: #3a332c80;
  }

  /* The label covers the photo's spindle, so draw one back on top. */
  .tt-spindle {
    position: absolute;
    left: 45.34%;
    top: 34.47%;
    width: 1.36%;
    height: 5.7%;
    border-radius: 50% 50% 30% 30% / 30% 30% 12% 12%;
    background: linear-gradient(90deg, #7d7a74, #f6f4ef 40%, #c9c6bf 60%, #8e8b85);
    box-shadow: 0.25cqw 0.3cqw 0.4cqw #0000004d;
  }

  /* Pivot = the arm's bearing (33.17%, 16.06% of the cut-out), set on the deck's socket. */
  .tt .tt-arm {
    position: absolute;
    left: 75.8%;
    top: 2.35%;
    width: 12.16%;
    transform-origin: 33.17% 16.06%;
    rotate: 3deg; /* resting clear of the START/STOP slider */
    filter: drop-shadow(0.6cqw 0.9cqw 0.6cqw #00000038);
    transition: rotate 800ms 250ms cubic-bezier(0.45, 0, 0.2, 1);
  }

  [data-phase="playing"] .tt-arm {
    rotate: 29deg; /* needle just inside the lead-in groove */
    transition-delay: 0ms;
  }

  .tt .tt-knob {
    position: absolute;
    left: 5.25%;
    top: 56.98%;
    width: 10.08%;
    filter: drop-shadow(0.4cqw 0.6cqw 0.5cqw #00000033);
  }

  .tt-slot {
    position: absolute;
    left: 86.7%;
    top: 65.2%;
    width: 0.9%;
    height: 11%;
    border-radius: 1cqw;
    background: #3b362f;
    box-shadow: inset 0 0.2cqw 0.3cqw #000;
  }

  .tt-power {
    position: absolute;
    left: 84.15%;
    top: 64.39%;
    width: 5.93%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transition: translate 180ms cubic-bezier(0.3, 1.3, 0.5, 1);
  }

  .tt-power[aria-pressed="true"] {
    translate: 0 13%;
  }

  .tt-power:focus-visible {
    outline: 2px solid black;
    outline-offset: 2px;
    border-radius: 0.4cqw;
  }

  [data-phase="playing"] .tt-disc {
    opacity: 1;
  }

  [data-phase="entering"] .tt-disc {
    animation: tt-drop 1100ms both;
  }

  /* Delayed so the arm swings clear first. */
  [data-phase="exiting"] .tt-disc {
    animation: tt-drop 800ms 550ms both reverse;
  }

  @keyframes tt-drop {
    0% {
      opacity: 0;
      transform: translateY(-18%) scale(1.08);
      filter: drop-shadow(0 4cqw 4cqw #0000);
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    65% {
      opacity: 1;
      transform: translateY(0) scale(1.05);
      filter: drop-shadow(0 2.5cqw 2.5cqw #00000038);
      animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.5);
    }
    88% {
      transform: scale(0.997);
      filter: drop-shadow(0 0.3cqw 0.4cqw #0000004d);
    }
    100% {
      opacity: 1;
      transform: none;
      filter: drop-shadow(0 0.3cqw 0.4cqw #0000004d);
    }
  }

  @keyframes tt-spin {
    to {
      rotate: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tt .tt-arm,
    .tt-power {
      transition: none;
    }
    .tt-spin,
    [data-phase] .tt-disc {
      animation: none !important;
    }
  }
</style>
