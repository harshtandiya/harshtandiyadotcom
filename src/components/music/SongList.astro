---
import { SONGS } from "./songs";
import { artworkAt, getTracks } from "./itunes";

const tracks = await getTracks();
---

<ol class="grid grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-12 pr-[6%]">
  {
    SONGS.map((song, i) => {
      const art = tracks[i]?.artwork;
      return (
        <li class="min-w-0">
          <button
            type="button"
            data-song={i}
            data-preview={tracks[i]?.preview}
            data-cuelume-press
            class="sleeve group w-full flex flex-col items-center gap-3 text-center cursor-pointer text-gray-500 hover:text-black aria-pressed:text-black transition-colors duration-150"
          >
            <span class="sleeve-art">
              <span class="sleeve-record" />
              {art ? (
                <img
                  src={artworkAt(art, 300)}
                  srcset={`${artworkAt(art, 300)} 300w, ${artworkAt(art, 600)} 600w`}
                  sizes="(min-width: 1024px) 200px, 40vw"
                  alt=""
                  loading="lazy"
                  width="300"
                  height="300"
                />
              ) : (
                <span class="block size-full bg-gray-200" />
              )}
            </span>
            <span class="w-full text-sm leading-snug">
              <span class="block truncate">{song.title}</span>
              <span class="block truncate text-gray-400">{song.artist}</span>
            </span>
          </button>
        </li>
      );
    })
  }
</ol>
<p data-status class="sr-only" aria-live="polite"></p>

<style is:global>
  .sleeve-art {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    transition: translate 300ms var(--ease-out-strong);
  }

  /* Cardboard sleeve: square, near-sharp corners, stacked shadows for weight,
     and a faint sheen plus edge highlight on top of the art. */
  .sleeve-art > img,
  .sleeve-art > span:last-child {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 2px;
    box-shadow:
      0 1px 1px #0000001f,
      0 3px 6px #0000001f,
      0 10px 20px -6px #00000033,
      0 24px 40px -16px #00000040;
  }

  .sleeve-art::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 2px;
    background: linear-gradient(135deg, #ffffff26, #fff0 38%, #fff0 70%, #0000001a);
    box-shadow:
      inset 0 0 0 1px #ffffff1a,
      inset 0 0 0 0.5px #0000001a;
    pointer-events: none;
  }

  /* The record inside, peeking out of the open side on hover. */
  .sleeve-record {
    position: absolute;
    inset: 3%;
    border-radius: 50%;
    background:
      radial-gradient(circle closest-side, #0000 0 5%, #d4572f 6% 30%, #0000 31%),
      repeating-radial-gradient(circle closest-side, #0000 0 1.2%, #ffffff0d 1.2% 1.8%),
      radial-gradient(circle closest-side, #151515 0 96%, #2a2a2a 98%);
    box-shadow: 0 4px 10px #00000040;
    transition: translate 400ms var(--ease-out-strong);
  }

  .sleeve:hover .sleeve-record,
  .sleeve:focus-visible .sleeve-record {
    translate: 22% 0;
  }

  /* Playing: its record is on the turntable, so the sleeve lifts, empty. */
  .sleeve[aria-pressed="true"] .sleeve-art {
    translate: 0 -6px;
  }

  .sleeve[aria-pressed="true"] .sleeve-record {
    translate: 0 0;
    opacity: 0;
  }

  .sleeve:focus-visible {
    outline: none;
  }

  .sleeve:focus-visible .sleeve-art {
    outline: 2px solid black;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .sleeve-art,
    .sleeve-record {
      transition: none;
    }
  }
</style>
