---
import LinkWithSound from "@/components/react/LinkWithSound";
import LinkWithArrow from "./LinkWithArrow.astro";
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <LinkWithSound
    client:load
    href="/thoughts"
    target="_self"
    className="no-style"
  >
    <LinkWithArrow label="Thoughts" />
  </LinkWithSound>
  <LinkWithSound
    client:load
    href="/projects"
    target="_self"
    className="no-style"
  >
    <LinkWithArrow label="Projects" />
  </LinkWithSound>
  <LinkWithSound client:load href="/music" target="_self" className="no-style">
    <LinkWithArrow label="Music I listen to" />
  </LinkWithSound>
  <LinkWithSound client:load href="/books" target="_self" className="no-style">
    <LinkWithArrow label="Books I'm reading" />
  </LinkWithSound>
</div>
