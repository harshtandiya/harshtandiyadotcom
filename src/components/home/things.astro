---
import LinkWithArrow from "./LinkWithArrow.astro";
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <a
    href="/thoughts"
    class="no-style group -m-2 p-2"
    data-cuelume-hover="tick"
    data-cuelume-press
  >
    <LinkWithArrow label="Thoughts" />
  </a>
  <a
    href="/projects"
    class="no-style group -m-2 p-2"
    data-cuelume-hover="tick"
    data-cuelume-press
  >
    <LinkWithArrow label="Projects" />
  </a>
  <a
    href="/music"
    class="no-style group -m-2 p-2"
    data-cuelume-hover="tick"
    data-cuelume-press
  >
    <LinkWithArrow label="Music I listen to" />
  </a>
  <a
    href="/books"
    class="no-style group -m-2 p-2"
    data-cuelume-hover="tick"
    data-cuelume-press
  >
    <LinkWithArrow label="Books I'm reading" />
  </a>
</div>
