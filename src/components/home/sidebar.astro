---
import { Image } from "astro:assets";
import ogNeko from "@/assets/neko/OgNeko.svg";

const NAV = [
  { href: "/", label: "About" },
  { href: "/thoughts", label: "Thoughts" },
  { href: "/projects", label: "Projects" },
  { href: "/music", label: "Music" },
  { href: "/books", label: "Books" },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(href + "/");
---

<aside
  transition:persist
  class="w-full shrink-0 md:w-60 flex flex-col gap-6 md:gap-8 pt-8 md:py-12 md:sticky md:top-0 md:h-svh md:pr-10"
>
  <a
    href="/"
    class="no-style flex md:flex-col gap-3 md:gap-4 items-center md:items-start"
    data-cuelume-press
    aria-label="Harsh Tandiya — home"
  >
    <Image
      src={ogNeko}
      class="w-auto h-10 md:h-12"
      alt="Cat that I use as my mascot"
      loading="eager"
    />
    <span class="flex flex-col gap-0.5">
      <span class="text-base font-semibold leading-tight">Harsh Tandiya</span>
      <span class="text-sm text-gray-500 leading-tight">Software Engineer</span>
    </span>
  </a>

  <nav aria-label="Primary">
    <ul class="flex flex-row flex-wrap gap-x-1 gap-y-1 md:flex-col md:gap-1 font-hand">
      {
        NAV.map((item) => {
          const active = isActive(item.href);
          return (
            <li>
              <a
                href={item.href}
                data-nav-href={item.href}
                aria-current={active ? "page" : undefined}
                data-cuelume-press
                class:list={[
                  "no-style inline-block rounded-md px-2 -mx-2 py-1 text-sm transition-colors duration-150",
                  active
                    ? "text-black"
                    : "text-gray-500 hover:text-black",
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <div class="hidden md:flex flex-col gap-2 text-sm">
    <h2 class="text-xs font-medium uppercase tracking-wider text-gray-400">
      Connect
    </h2>
    <a href="mailto:hi@harshtandiya.com" data-cuelume-press>
      hi@harshtandiya.com
    </a>
    <div class="flex flex-col gap-1.5">
      <a
        href="https://x.com/tandiyaharsh"
        target="_blank"
        rel="noopener noreferrer"
        data-cuelume-press
      >
        X/Twitter
      </a>
      <a
        href="https://github.com/harshtandiya"
        target="_blank"
        rel="noopener noreferrer"
        data-cuelume-press
      >
        GitHub
      </a>
      <a
        href="https://linkedin.com/in/harshtandiya"
        target="_blank"
        rel="noopener noreferrer"
        data-cuelume-press
      >
        LinkedIn
      </a>
    </div>
  </div>

  <div class="hidden md:block">
    <a
      href="https://creativecommons.org/licenses/by-nc-sa/4.0/?ref=chooser-v1"
      target="_blank"
      rel="noopener noreferrer"
      data-cuelume-press
      class="text-gray-400 text-xs font-sans"
    >
      CC BY-NC-SA 4.0
    </a>
  </div>
</aside>

<script>
  // The sidebar persists across ClientRouter navigations (transition:persist),
  // so the server-rendered active state would go stale — re-sync it on every page load.
  function syncSidebarNav() {
    const path = window.location.pathname;
    document.querySelectorAll("a[data-nav-href]").forEach((el) => {
      const href = el.getAttribute("data-nav-href") ?? "/";
      const active =
        href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
      el.classList.toggle("text-black", active);
      el.classList.toggle("text-gray-500", !active);
      if (active) {
        el.setAttribute("aria-current", "page");
      } else {
        el.removeAttribute("aria-current");
      }
    });
  }

  document.addEventListener("astro:page-load", syncSidebarNav);
  syncSidebarNav();
</script>
