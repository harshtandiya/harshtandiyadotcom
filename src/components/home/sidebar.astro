---
const NAV = [
  { href: "/", label: "About" },
  { href: "/thoughts", label: "Thoughts" },
  { href: "/projects", label: "Projects" },
  { href: "/music", label: "Music" },
  { href: "/books", label: "Books" },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(href + "/");
---

<aside
  transition:persist
  class="w-full shrink-0 md:w-40 flex flex-col items-start gap-6 md:gap-8 pt-8 pb-4 md:py-12 md:pl-8 md:sticky md:top-0 md:h-svh"
>
  <a
    href="/"
    class="no-style hidden md:block"
    data-cuelume-press
    data-astro-prefetch="load"
    aria-label="Harsh Tandiya — home"
  >
    <span class="block text-base font-semibold leading-tight">Harsh Tandiya</span>
    <span class="block mt-0.5 text-xs text-gray-500 leading-tight">Software Engineer</span>
  </a>

  <nav aria-label="Primary">
    <ul class="flex flex-row flex-wrap gap-x-4 gap-y-2 md:flex-col md:gap-1 font-hand">
      {
        NAV.map((item) => {
          const active = isActive(item.href);
          return (
            <li>
              <a
                href={item.href}
                data-nav-href={item.href}
                data-astro-prefetch="load"
                aria-current={active ? "page" : undefined}
                data-cuelume-press
                class:list={[
                  "no-style inline-block rounded-md px-2 -mx-2 py-1 text-xs md:text-sm transition-colors duration-150",
                  active
                    ? "text-black"
                    : "text-gray-500 hover:text-black",
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <div class="hidden md:flex flex-col items-start gap-1 mt-auto text-xs text-gray-400">
    <a href="mailto:hi@harshtandiya.com" data-cuelume-press>hi@harshtandiya.com</a>
    <a
      href="https://x.com/tandiyaharsh"
      target="_blank"
      rel="noopener noreferrer"
      data-cuelume-press>X</a
    >
    <a
      href="https://github.com/harshtandiya"
      target="_blank"
      rel="noopener noreferrer"
      data-cuelume-press>GitHub</a
    >
    <a
      href="https://linkedin.com/in/harshtandiya"
      target="_blank"
      rel="noopener noreferrer"
      data-cuelume-press>LinkedIn</a
    >
    <a
      href="https://creativecommons.org/licenses/by-nc-sa/4.0/?ref=chooser-v1"
      target="_blank"
      rel="noopener noreferrer"
      data-cuelume-press>CC BY-NC-SA 4.0</a
    >
  </div>
</aside>

<script>
  // The sidebar persists across ClientRouter navigations (transition:persist),
  // so the server-rendered active state would go stale — re-sync it on every page load.
  function syncSidebarNav() {
    const path = window.location.pathname;
    document.querySelectorAll("a[data-nav-href]").forEach((el) => {
      const href = el.getAttribute("data-nav-href") ?? "/";
      const active =
        href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
      el.classList.toggle("text-black", active);
      el.classList.toggle("text-gray-500", !active);
      if (active) {
        el.setAttribute("aria-current", "page");
      } else {
        el.removeAttribute("aria-current");
      }
    });
  }

  document.addEventListener("astro:page-load", syncSidebarNav);
  syncSidebarNav();
</script>
