---
import { Image } from "astro:assets";
import ogNeko from "@/assets/neko/OgNeko.svg";
---

<div class="flex flex-col gap-6 items-start">
  <a href="/" class="no-style">
    <Image
      src={ogNeko}
      class="w-auto h-12"
      alt="Cat that I use as my mascot"
      loading="eager"
    />
  </a>
  <div class="flex flex-col gap-1">
    <h1 class="text-lg font-semibold">Harsh Tandiya</h1>
    <h2>Software Engineer</h2>
  </div>
  <p>
    Crafting polished software and experiences at
    <a
      href="https://studios.buildwithhussain.com"
      target="_blank"
      rel="noopener noreferrer">BWH Studios</a
    >
    <br />
    <br />
    I believe great software shows care in the details and I strive to bring that
    level of craftsmanship to every project.
    <br />
    <br />
    I'm currently based in <span class="italic">Bengaluru, India</span>.
  </p>
</div>
