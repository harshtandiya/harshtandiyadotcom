---
const { label } = Astro.props;
import { ArrowRight } from "@lucide/astro";
---

<div class="flex items-center gap-1">
  {label}
  <ArrowRight
    class="w-4 h-4 text-gray-400 transition-[translate,color] duration-150 ease-out-strong group-hover:text-gray-900 group-focus-visible:text-gray-900 motion-safe:group-hover:translate-x-1 motion-safe:group-focus-visible:translate-x-1"
  />
</div>
